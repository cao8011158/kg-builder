{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Research extraction v0.3 retrieval pilot",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "paper_id", "version_id", "paper_version", "extractor_type", "extractor_version", "source_scope", "status", "contributions", "research_problems", "methods", "benchmarks"],
  "properties": {
    "schema_version": {"const": "research-kg-extraction/0.3-retrieval"},
    "paper_id": {"$ref": "#/$defs/nonblank"},
    "version_id": {"$ref": "#/$defs/nonblank"},
    "paper_version": {
      "type": "object", "additionalProperties": false,
      "required": ["version_label", "source_url"],
      "properties": {
        "version_label": {"oneOf": [{"type": "string", "pattern": "^v[1-9][0-9]*$"}, {"type": "null"}]},
        "source_url": {"$ref": "#/$defs/url"}
      }
    },
    "extractor_type": {"$ref": "#/$defs/nonblank"},
    "extractor_version": {"$ref": "#/$defs/nonblank"},
    "source_scope": {"$ref": "#/$defs/nonblank"},
    "status": {"$ref": "#/$defs/nonblank"},
    "contributions": {"type": "array", "items": {"$ref": "#/$defs/contribution"}},
    "research_problems": {"type": "array", "items": {"$ref": "#/$defs/concept"}},
    "methods": {"type": "array", "items": {"$ref": "#/$defs/method"}},
    "benchmarks": {"type": "array", "items": {"$ref": "#/$defs/benchmark"}}
  },
  "$defs": {
    "nonblank": {"type": "string", "pattern": "\\S"},
    "url": {"type": "string", "pattern": "^https?://\\S+$"},
    "contribution": {
      "type": "object", "additionalProperties": false,
      "required": ["key", "description"],
      "properties": {"key": {"$ref": "#/$defs/nonblank"}, "description": {"$ref": "#/$defs/nonblank"}, "section": {"$ref": "#/$defs/nonblank"}, "source_url": {"$ref": "#/$defs/url"}}
    },
    "concept": {
      "type": "object", "additionalProperties": false,
      "required": ["key", "name", "description"],
      "properties": {"key": {"$ref": "#/$defs/nonblank"}, "name": {"$ref": "#/$defs/nonblank"}, "description": {"$ref": "#/$defs/nonblank"}, "section": {"$ref": "#/$defs/nonblank"}, "source_url": {"$ref": "#/$defs/url"}}
    },
    "method": {
      "type": "object", "additionalProperties": false,
      "required": ["key", "name", "description", "role"],
      "properties": {"key": {"$ref": "#/$defs/nonblank"}, "name": {"$ref": "#/$defs/nonblank"}, "description": {"$ref": "#/$defs/nonblank"}, "role": {"enum": ["proposed", "used", "involved"]}, "section": {"$ref": "#/$defs/nonblank"}, "source_url": {"$ref": "#/$defs/url"}}
    },
    "benchmark": {
      "type": "object", "additionalProperties": false,
      "required": ["key", "name", "description", "roles", "version_or_subset"],
      "properties": {"key": {"$ref": "#/$defs/nonblank"}, "name": {"$ref": "#/$defs/nonblank"}, "description": {"$ref": "#/$defs/nonblank"}, "roles": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["introduced", "used"]}}, "version_or_subset": {"oneOf": [{"$ref": "#/$defs/nonblank"}, {"type": "null"}]}, "section": {"$ref": "#/$defs/nonblank"}, "source_url": {"$ref": "#/$defs/url"}}
    }
  }
}
